<Window x:ConnectionId='1'
    x:Class="pos.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:pos"
    xmlns:models="using:pos.Models"
    x:Name="RootWindow"
    Title="Punto de Venta - Taquería">

    <Grid Padding="20" ColumnSpacing="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0">
            <TextBlock Text="Menú de Tacos" FontSize="24" FontWeight="Bold" Margin="0,0,0,15"/>
            <ListView x:ConnectionId='10'                                       SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate                         >
                        <Grid x:ConnectionId='12' Padding="10" ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:ConnectionId='13'                        FontSize="18" VerticalAlignment="Center"/>
                            <TextBlock x:ConnectionId='14' Grid.Column="1"                        FontSize="16" Foreground="Gray" VerticalAlignment="Center"/>

                            <Button x:ConnectionId='15' Grid.Column="2" Content="Agregar" 
                                    Command="{Binding ElementName=RootWindow, Path=ViewModel.AgregarAlCarritoCommand}" 
                                                               />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>

        <StackPanel Grid.Column="1" Width="350" Spacing="15">
            <TextBlock Text="Ticket de Compra" FontSize="22" FontWeight="Bold"/>

            <ListView x:ConnectionId='2'                                          SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate                         >
                        <Grid x:ConnectionId='6' Padding="8" ColumnSpacing="5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:ConnectionId='7'                        VerticalAlignment="Center"/>
                            <NumberBox x:ConnectionId='8' Grid.Column="1"                                        
                                       Minimum="1" Maximum="50" SpinButtonPlacementMode="Inline" 
                                       Width="80"/>

                            <Button x:ConnectionId='9' Grid.Column="2" Content="❌" 
                                    Command="{Binding ElementName=RootWindow, Path=ViewModel.QuitarDelCarritoCommand}" 
                                                               />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <Border BorderThickness="1" BorderBrush="Gray" Padding="10" CornerRadius="5">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="Total:" FontSize="20" FontWeight="Bold" HorizontalAlignment="Left"/>
                        <TextBlock x:ConnectionId='4'                                              FontSize="20" FontWeight="Bold" HorizontalAlignment="Right"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Button x:ConnectionId='3' Content="Guardar Ticket (JSON)"                             
                    HorizontalAlignment="Stretch" Background="Green" Foreground="White" 
                    FontSize="16" Padding="10"/>
        </StackPanel>
    </Grid>
</Window>

